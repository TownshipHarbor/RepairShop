<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>RepairShopQuest</AssemblyName>
    <RootNamespace>RepairShopQuest</RootNamespace>
    <DefineConstants>QUEST</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <LemonNet8 Condition="'$(LemonNet8)' == ''">..\lemon\net8</LemonNet8>
    <LemonProxies Condition="'$(LemonProxies)' == ''">..\lemon\Il2CppAssemblies</LemonProxies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\src\**\*.cs" />
    <EmbeddedResource Include="..\res\repairshop.pack" LogicalName="RepairShopQuest.repairshop.pack" />
    <Reference Include="$(LemonNet8)\MelonLoader.dll;$(LemonNet8)\0Harmony.dll;$(LemonNet8)\Il2CppInterop.Runtime.dll;$(LemonNet8)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(LemonProxies)\*.dll" Private="false" />
  </ItemGroup>
</Project>
